# Database (Neon / Vercel Postgres) — required
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js / NextAuth — required
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://your-app.vercel.app"

# App URLs — required (use your Vercel domain)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Commerce
PLATFORM_FEE_BPS=1000
CRON_SECRET="long-random-string-for-cron-auth"

# Seed (optional — used by npm run db:seed)
SEED_ADMIN_EMAIL="admin@wellnesstech.local"
SEED_ADMIN_PASSWORD="Demo1234!"
SEED_DEMO_PASSWORD="Demo1234!"

# Vercel KV / Upstash Redis — optional (memory fallback if unset)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_URL=
REDIS_URL=

# Vercel Blob — optional (product image uploads)
BLOB_READ_WRITE_TOKEN=

# Stripe — optional until checkout is tested
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — optional until email is tested
RESEND_API_KEY=
RESEND_FROM_EMAIL="Wellness Tech Bio Distribution <noreply@your-verified-domain.com>"
AGE_CONFIRM_TO="contact@keepingitallnatural.com"
