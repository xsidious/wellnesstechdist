generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  AMBASSADOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SubOrderStatus {
  PENDING
  PAID
  FULFILLING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum LedgerType {
  ADMIN_FEE
  PROVIDER_EARNING
  AMBASSADOR_COMMISSION
  PAYOUT
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  PAID
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  providerProfile   ProviderProfile?
  ambassadorProfile AmbassadorProfile?
  carts             Cart[]
  orders            Order[]
  ageConfirmations  AgeConfirmation[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProviderProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  businessName         String
  approved             Boolean  @default(false)
  stripeAccountId      String?
  phone                String?
  username             String?  @unique
  businessType         String?
  practitionerType     String?
  npi                  String?
  deaNumber            String?
  physicianName        String?
  physicianNpi         String?
  officeStreet1        String?
  officeStreet2        String?
  officeCity           String?
  officeState          String?
  officeZip            String?
  shippingSameAsOffice Boolean  @default(true)
  shippingStreet1      String?
  shippingStreet2      String?
  shippingCity         String?
  shippingState        String?
  shippingZip          String?
  businessHours        String?
  referralName         String?
  referralEmail        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products             Product[]
  subOrders            SubOrder[]

  @@index([approved])
  @@index([npi])
}

model AmbassadorProfile {
  id                   String           @id @default(cuid())
  userId               String           @unique
  code                 String           @unique
  walletBalance        Int              @default(0)
  phone                String?
  username             String?          @unique
  companyName          String?
  businessType         String?
  officeStreet1        String?
  officeStreet2        String?
  officeCity           String?
  officeState          String?
  officeZip            String?
  shippingSameAsOffice Boolean          @default(true)
  shippingStreet1      String?
  shippingStreet2      String?
  shippingCity         String?
  shippingState        String?
  shippingZip          String?
  businessHours        String?
  referralName         String?
  referralEmail        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  links                AmbassadorLink[]
  discountCodes        DiscountCode[]
  orders               Order[]          @relation("OrderAmbassador")
  ledgerEntries        LedgerEntry[]

  @@index([code])
}

model CommissionTier {
  id            String   @id @default(cuid())
  name          String
  percentBps    Int
  minOrderCents Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, minOrderCents])
}

model AmbassadorLink {
  id           String            @id @default(cuid())
  ambassadorId String
  slug         String            @unique
  destination  String            @default("/")
  clicks       Int               @default(0)
  createdAt    DateTime          @default(now())
  ambassador   AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId])
}

model DiscountCode {
  id           String             @id @default(cuid())
  ambassadorId String?
  code         String             @unique
  percentOff   Int
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  ambassador   AmbassadorProfile? @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)

  @@index([ambassadorId, active])
}

model Product {
  id          String           @id @default(cuid())
  providerId  String
  slug        String           @unique
  name        String
  description String           @db.Text
  category    String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  provider    ProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([providerId, active])
  @@index([category])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  sku        String      @unique
  name       String
  attrs      Json
  priceCents Int
  stock      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([stock])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                    String             @id @default(cuid())
  userId                String?
  email                 String
  status                OrderStatus        @default(PENDING)
  subtotalCents         Int
  feeCents              Int
  commissionCents       Int                @default(0)
  totalCents            Int
  currency              String             @default("usd")
  stripePaymentIntentId String?            @unique
  ambassadorId          String?
  ambassadorCode        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  ambassador            AmbassadorProfile? @relation("OrderAmbassador", fields: [ambassadorId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  subOrders             SubOrder[]
  ledgerEntries         LedgerEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([ambassadorId])
}

model SubOrder {
  id            String          @id @default(cuid())
  orderId       String
  providerId    String
  status        SubOrderStatus  @default(PENDING)
  subtotalCents Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  ledgerEntries LedgerEntry[]

  @@index([orderId])
  @@index([providerId, status])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  subOrderId     String
  variantId      String
  productName    String
  variantName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder       SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([subOrderId])
  @@index([variantId])
}

model LedgerEntry {
  id           String             @id @default(cuid())
  orderId      String?
  subOrderId   String?
  ambassadorId String?
  type         LedgerType
  status       LedgerStatus       @default(PENDING)
  amountCents  Int
  description  String?
  createdAt    DateTime           @default(now())
  paidAt       DateTime?
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subOrder     SubOrder?          @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  ambassador   AmbassadorProfile? @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([orderId])
  @@index([subOrderId])
  @@index([ambassadorId, status])
  @@index([createdAt])
}

model AgeConfirmation {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  path      String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

model ClickEvent {
  id        String   @id @default(cuid())
  name      String
  source    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model SiteContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([key])
}
